# 复制为 .env 后填写；.env 已 gitignore，勿提交密钥。

# —— LLM / 模型配置 ——
# 真源已迁到 Web「模型配置」→ 本机 {FAWAI_DATA_DIR}/llm_settings.sqlite
# （供应商凭证 + 按角色「供应商→模型」路由 + 模型参数档案）。
# 下列 FAWAI_LLM_* / FAWAI_LORE_EMBED_MODEL 仅作首次启动迁移种子；运行时不再读取。
# FAWAI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FAWAI_LLM_API_KEY=
# FAWAI_LLM_TEXT_MODEL=qwen3.7-plus
# FAWAI_LLM_VLM_MODEL=qwen3-vl-plus
# FAWAI_LLM_ASR_MODEL=qwen3-asr-flash
# FAWAI_LLM_FAST_MODEL=qwen3.8-27b
# FAWAI_LORE_EMBED_MODEL=text-embedding-v3
# FAWAI_LLM_MODEL=

FAWAI_DRY_RUN=1
FAWAI_DATA_DIR=data
# 工作区根（写/改文件限此目录）；相对路径相对进程 cwd
# FAWAI_WORK_ROOT=.
# 只读根：默认 /（整盘可读，macOS 启动会引导「完全磁盘访问」）；冒号分隔多根；设 work 则仅 work_root
# FAWAI_READ_ROOTS=/
# 个人知识库（fawai_lore KV+笔记）根目录；不设则用 {FAWAI_DATA_DIR}/lore
# FAWAI_LORE_DIR=
# 长记忆旁路：默认开；用户消息+成功任务终稿自动抽；关：FAWAI_LORE_SIDECAR=0
# FAWAI_LORE_SIDECAR=1
# P0 路径类直写 KV；P1 默认进「记忆缓冲」待确认。若要 P1 也直写：FAWAI_LORE_AUTO_P1_KV=1
# FAWAI_LORE_AUTO_P1_KV=0
# LLM 补抽：auto=有 API key 则开；0 强制关；1 强制开
# FAWAI_LORE_LLM_EXTRACT=auto
# 笔记向量检索（sqlite-vec）：默认 auto=已安装 sqlite-vec 则开；0 强制关；1 强制开
# FAWAI_LORE_VECTOR=auto

# 运行平台：不设则自动探测（无 DISPLAY/WAYLAND → headless）
# FAWAI_HEADLESS=1   # 强制无界面：禁 GUI/截屏，编码·文件·shell·browser_* 仍可用
# FAWAI_HEADLESS=0   # 强制按有桌面（仍须本机真有显示才跑得动截屏）

# 内置浏览器（Playwright；需 pip install -e '.[browser]' && playwright install chromium）
# FAWAI_BROWSER_HEADLESS=1   # 默认无头；设 0 可见窗口
# FAWAI_BROWSER_CHANNEL=     # 可选 chrome / msedge
# FAWAI_BROWSER_TIMEOUT_MS=30000

# 工作任务最大步数：0（默认）=不限制；>0 则超过后 fail（max_steps exceeded）
# FAWAI_MAX_STEPS=0

# 大脑：1=不调 LLM（进度会显示 mock）；0=走真实模型
FAWAI_BRAIN_MOCK=0

# 步骤重复守卫：1=开启（默认）；0=关闭。N=同步骤指纹累计几次触发 LLM（默认 2，最小 2）
# FAWAI_STEP_REPEAT=1
# FAWAI_STEP_REPEAT_N=2

# 答复覆盖闸（问询假成功/过程元叙述）：默认关；要启用设 1
# FAWAI_ANSWER_COVERAGE_GATE=0

# 探索进度闸门：默认关（不因只读步数逼写）。>0 才软提示；ABORT 须显式 >0 才强制改写
# FAWAI_EXPLORE_ONLY_GATE=0
# FAWAI_EXPLORE_ONLY_ABORT=

# 远端/部署类进度闸：连续无 ssh/rsync 副作用则换方法族；默认 6（非部署目标自动 0）；中止 2×GATE
# FAWAI_REMOTE_IDLE_GATE=6
# FAWAI_REMOTE_IDLE_ABORT=
# 同一 path 成功 fs_read 达 N 次时探索 streak 额外 +1（0=关）
# FAWAI_EXPLORE_REPEAT_READ_BOOST=3
# 规划历史窗：近窗条数 / 压缩后字符软上限
# FAWAI_HISTORY_KEEP_RECENT=8
# FAWAI_HISTORY_MAX_CHARS=18000

# 会话网关（局域网）
# FAWAI_GATEWAY_HOST=0.0.0.0
FAWAI_GATEWAY_PORT=7980
# 会话口令：填写则固定；留空或不写则每次启动随机生成
# FAWAI_GATEWAY_PASSCODE=AB12CD
# FAWAI_GATEWAY_CAPTURE=0
# 服务保活：默认开启（fawai-gateway 套外层）。调试可关：
# FAWAI_NO_KEEPER=1
# 子进程由保活拉起时会自动带 FAWAI_KEEPER=1，勿手改。
# 代码热重载：默认开（仅监视 fawai_avatar 下 .py/.html/.js/.css）。长任务实操可关：
# FAWAI_CODE_RELOAD=0
# 端口回收：默认开（保活拉起前清理占用 FAWAI_GATEWAY_PORT 的本产品野进程）。关：
# FAWAI_PORT_RECLAIM=0

# frpc 穿透（配齐 SERVER_ADDR + REMOTE_PORT 时，网关启动会拉起本机 frpc）
# 公网访问：http://<FAWAI_FRP_SERVER_ADDR>:<FAWAI_FRP_REMOTE_PORT>/
FAWAI_FRP_SERVER_ADDR=8.137.33.38
FAWAI_FRP_SERVER_PORT=37000
FAWAI_FRP_REMOTE_PORT=38443
# 多机同 frps 时须改代理段名，避免 “proxy name already in use”
# FAWAI_FRP_PROXY_NAME=fawai-avatar-gateway
# FAWAI_FRP_ENABLE=0
# Linux：勿用仓库自带 darwin 版 bin/frpc；改为本机 ELF，例如：
# FAWAI_FRPC_BIN=/usr/local/bin/frpc
# FAWAI_FRPC_BIN=
# FAWAI_FRP_LOCAL_IP=127.0.0.1

# 云端中继（可选；未设则跳过）
# FAWAI_RELAY_URL=
# FAWAI_RELAY_DEVICE_TOKEN=
# FAWAI_RELAY_PAIR_CODE=
FAWAI_WORK_ROOT=.
FAWAI_AUTO_VERSION=1

# 编码闭环（朝 Cursor）
# FAWAI_DIFF_MODE=auto          # auto | confirm
# FAWAI_NATIVE_TOOLS=1          # 编码类目标原生 tool_calls
# FAWAI_FULL_WRITE_LINE_LIMIT=80  # 已存在大文件禁止无 force 的整写

# 工具结果观察（obs_tool）：默认不压缩；体量靠工具 head_limit/limit
# FAWAI_TOOL_OBS_SOFT_CHARS=0       # 0=关；>0 才压缩 stdout 等
# FAWAI_TOOL_OBS_HITS_SOFT_CHARS=0  # 0=hits 全文回灌；>0 才按字符压缩
# FAWAI_TOOL_OBS_HARD_CHARS=6000
# FAWAI_TOOL_OBS_HEAD_LINES=24
# FAWAI_TOOL_OBS_TAIL_LINES=40
# FAWAI_TOOL_OBS_KEYWORD_HITS=24
# FAWAI_TOOL_OBS_FS_READ_LINES=0   # 0=读多少回灌多少；>0 才额外硬顶
# FAWAI_WIDE_GREP_HITS=0            # 0=关宽检索降质；>0 才注入
# FAWAI_WIDE_GREP_FILE_HITS=0
